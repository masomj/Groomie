# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pampered_pooch?schema=public"

# Session signing secret (change in production!)
SESSION_SECRET="change-me-to-a-random-64-char-string"

# Stripe (required for payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App base URL (used for Stripe redirect URLs)
APP_BASE_URL="http://localhost:3000"

# Email (optional - if not set, confirmations are logged instead of emailed)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASS="your-password"
# SMTP_FROM="bookings@pamperedpooch.co.uk"
