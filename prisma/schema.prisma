generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Sex {
  MALE
  FEMALE
}

enum Friendliness {
  YES
  NO
  UNSURE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dogs            Dog[]
  appointments    Appointment[]
  consentRecords  ConsentRecord[]
  invoices        Invoice[]
  sessions        Session[]

  @@index([role])
  @@map("users")
}

// ─── Session ────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Dog ────────────────────────────────────────────────────────────────────

model Dog {
  id               String       @id @default(cuid())
  ownerId          String       @map("owner_id")
  name             String
  age              Int?
  breed            String?
  sex              Sex?
  neutered         Boolean?
  vaccinated       Boolean?
  medicalHistory   String?      @map("medical_history")
  dogFriendly      Friendliness @default(UNSURE) @map("dog_friendly")
  peopleFriendly   Friendliness @default(UNSURE) @map("people_friendly")
  emergencyVetName String?      @map("emergency_vet_name")
  emergencyVetAddr String?      @map("emergency_vet_addr")
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([ownerId])
  @@map("dogs")
}

// ─── Service ────────────────────────────────────────────────────────────────

model Service {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  priceFrom   Int     @map("price_from") // stored in pence
  priceTo     Int?    @map("price_to")   // stored in pence
  durationMin Int     @map("duration_min") // minutes
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  appointments Appointment[]

  @@map("services")
}

// ─── Appointment ────────────────────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  dogId       String            @map("dog_id")
  serviceId   String            @map("service_id")
  status      AppointmentStatus @default(PENDING)
  dateTime    DateTime          @map("date_time")
  durationMin Int               @map("duration_min")
  priceCharged Int?             @map("price_charged") // pence
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog            Dog             @relation(fields: [dogId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  consentRecords ConsentRecord[]
  payment        Payment?
  invoiceItems   InvoiceItem[]

  @@index([userId])
  @@index([dogId])
  @@index([dateTime])
  @@index([status])
  @@map("appointments")
}

// ─── Consent ────────────────────────────────────────────────────────────────

model ConsentTemplate {
  id        String   @id @default(cuid())
  version   Int
  title     String
  body      String
  questions Json?    // optional structured questions
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  records ConsentRecord[]

  @@unique([title, version])
  @@map("consent_templates")
}

model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  appointmentId String?  @map("appointment_id")
  templateId    String   @map("template_id")
  accepted      Boolean
  payload       Json?    // captured form snapshot
  capturedAt    DateTime @default(now()) @map("captured_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  template    ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([appointmentId])
  @@map("consent_records")
}

// ─── Payment ────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  appointmentId String        @unique @map("appointment_id")
  amountPence   Int           @map("amount_pence")
  status        PaymentStatus @default(PENDING)
  provider      String?       // e.g. "stripe"
  providerRef   String?       @map("provider_ref")
  checkoutSessionId String?   @unique @map("checkout_session_id")
  paidAt        DateTime?     @map("paid_at")
  pdfPath       String?       @map("pdf_path")
  createdAt     DateTime      @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── Invoice ────────────────────────────────────────────────────────────────

model Invoice {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  number     String        @unique // e.g. INV-0001
  status     InvoiceStatus @default(DRAFT)
  totalPence Int           @map("total_pence")
  issuedAt   DateTime?     @map("issued_at")
  dueAt      DateTime?     @map("due_at")
  paidAt     DateTime?     @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InvoiceItem[]

  @@index([userId])
  @@map("invoices")
}

model InvoiceItem {
  id            String @id @default(cuid())
  invoiceId     String @map("invoice_id")
  appointmentId String? @map("appointment_id")
  description   String
  amountPence   Int    @map("amount_pence")

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

// ─── Lead ───────────────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@map("leads")
}

// ─── Availability ───────────────────────────────────────────────────────────

model AvailabilitySlot {
  id        String   @id @default(cuid())
  dayOfWeek Int      @map("day_of_week") // 0=Sun, 6=Sat
  startTime String   @map("start_time")  // "09:00"
  endTime   String   @map("end_time")    // "17:00"
  active    Boolean  @default(true)

  @@unique([dayOfWeek, startTime])
  @@map("availability_slots")
}

// ─── Blockout Periods ──────────────────────────────────────────────────────

model BlockoutPeriod {
  id        String   @id @default(cuid())
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startsAt])
  @@index([endsAt])
  @@map("blockout_periods")
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─── Stripe Event Idempotency ──────────────────────────────────────────────

model StripeEvent {
  id          String   @id // Stripe event ID (evt_xxx)
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

// ─── Payment Confirmation Log ──────────────────────────────────────────────

model PaymentConfirmation {
  id          String   @id @default(cuid())
  paymentId   String   @map("payment_id")
  channel     String   // "email" or "log"
  recipient   String?  // email address or "system"
  subject     String?
  sentAt      DateTime @default(now()) @map("sent_at")
  success     Boolean  @default(true)
  error       String?

  @@index([paymentId])
  @@map("payment_confirmations")
}
